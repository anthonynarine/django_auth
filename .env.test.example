# Filename: .env.test.example
# Example environment for PostgreSQL-only Django tests.
# Copy these names into your local environment or private .env.test file.
# Do not commit real secrets.

POSTGRES_TEST_DB_NAME=auth_test_db
POSTGRES_TEST_DB_USER=auth_test_user
POSTGRES_TEST_DB_PASSWORD=replace-with-local-test-password
POSTGRES_TEST_DB_HOST=localhost
POSTGRES_TEST_DB_PORT=5432
POSTGRES_TEST_DATABASE_NAME=test_auth_test_db

# Optional local SMTP smoke-test placeholders. Do not commit real passwords.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=security@gaitobservatory.com
EMAIL_HOST_PASSWORD=replace-with-zoho-app-password
DEFAULT_FROM_EMAIL=Gait Security <security@gaitobservatory.com>
SERVER_EMAIL=security@gaitobservatory.com
